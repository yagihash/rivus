{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Asia/Tokyo)",
    "helpers:pinGitHubActionDigestsToSemver",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "yagihash"
  ],
  "schedule": [
    "after 8pm on friday"
  ],
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
    "**/node_modules/**",
    "bench/**",
    "testdata/**",
    "extractor/*/test/**",
    ".claude/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 8pm on friday"
    ]
  },
  "packageRules": [
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Pin GitHub Actions to commit SHA for security",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Group and automerge GitHub Actions digest/minor/patch updates",
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Group golang.org/x/* updates together",
      "groupName": "golang.org/x packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "golang.org/x{/,}**"
      ]
    },
    {
      "description": "Automerge Go module minor/patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The go directive of go.mod is the floor of the toolchain: never automerge",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "automerge": false
    },
    {
      "description": "Rust (extractor/rust): keep the ranges in Cargo.toml and move only Cargo.lock",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Automerge Rust crate minor/patch updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Dart (extractor/dart): bump the constraints in pubspec.yaml together with pubspec.lock",
      "matchManagers": [
        "pub"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Automerge Dart package minor/patch updates",
      "matchManagers": [
        "pub"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The Dart SDK of CI moves with package:analyzer: never automerge",
      "matchDepNames": [
        "dart"
      ],
      "automerge": false
    },
    {
      "description": "The pinned Rust nightly moves with the extractor (rustc_public is unstable): never automerge. The source gives only the newest date and no release time, so minimumReleaseAge would wait for ever",
      "matchDepNames": [
        "rust-nightly"
      ],
      "automerge": false,
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dart SDK version of setup-dart in ci.yml",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "sdk: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "dart",
      "datasourceTemplate": "dart-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The pinned Rust nightly (nightly-YYYY-MM-DD) in every file that states it as the current one: rust-toolchain.toml, the code, ci.yml and the documents. Not in docs/adr, docs/history, docs/issues (records of what was decided or seen then) and not in the tests (their dates are test data)",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs\\/[^/]+\\.md$/",
        "/^docs\\/design-package-models\\/[^/]+\\.md$/",
        "/^extractor\\/rust\\/[^/]+\\.(toml|md|rs)$/",
        "/^extractor\\/rust\\/src\\/.+\\.rs$/",
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/",
        "/^cmd\\/rivus\\/(isolate|lang)\\.go$/",
        "/^scripts\\/[^/]+\\.sh$/"
      ],
      "matchStrings": [
        "nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"
      ],
      "depNameTemplate": "rust-nightly",
      "datasourceTemplate": "custom.rust-nightly",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "customDatasources": {
    "rust-nightly": {
      "description": "The date of the newest Rust nightly: one line, e.g. 2026-11-23 (one release for Renovate)",
      "defaultRegistryUrlTemplate": "https://static.rust-lang.org/dist/channel-rust-nightly-date.txt",
      "format": "plain"
    }
  }
}
