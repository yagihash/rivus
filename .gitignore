.rivus/
/rivus
*.test
/rust/target/
.dart_tool/
/extractor/rust/target/
/bench/zoo-rust/target/
/bench/zoo-rust/exec/target/
__pycache__/
*.pyc
# backups that `sed -i` leaves (the BSD sed on macOS asks for a suffix)
*.go-e
# the reviews of the advisor session (they can hold the details of a vulnerability that is not fixed yet; the repository is public)
/.claude/reviews/
/.claude/work/
# the Dart zoo's lock files are not committed (two cells' branches would conflict on them); `dart pub get` makes them
/bench/zoo-dart/cells/pubspec.lock
/bench/zoo-dart/exec/pubspec.lock
/bench/zoo-dart/exec/lib/cases.dart
/bench/zoo-rust-pkg/*/target/
/bench/zoo-dart/cells/pubspec.yaml
/bench/zoo-dart/exec/pubspec.yaml
# the table of the issues that `make docs-gen OUT=...` writes (a generated view: docs/issues has the data)
/docs/ISSUES-TABLE.md
/docs/ADR-TABLE.md
/docs/TABLE.md

# a built binary of bench/model-diff at the root (go build ./bench/model-diff puts it here), and editor/sed backups
/model-diff
*.bak
