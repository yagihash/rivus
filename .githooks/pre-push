#!/usr/bin/env bash
# pre-push: refuse a push to a branch of origin whose pull request is already merged or closed (and has no open one).
# Commits pushed there never reach main (this happened 4 times). Enable it with `make setup`, or
#   git config core.hooksPath .githooks
# Override for a deliberate case: RIVUS_ALLOW_PUSH_TO_MERGED=1 git push ...
# git gives "<remote name> <url>" as arguments and "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Never blocks when gh is missing or the API call fails (a WARNING is printed). Tested by scripts/prepush_hook_test.go.
set -u
remote=${1:-}
[ "$remote" = origin ] || exit 0
[ "${RIVUS_ALLOW_PUSH_TO_MERGED:-}" = 1 ] && exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha rref _rsha; do
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  [ "$lsha" = "$zero" ] && continue # deleting the remote branch is fine
  b=${rref#refs/heads/}
  [ "$b" = main ] && continue
  if ! command -v gh >/dev/null 2>&1; then
    echo "pre-push: WARNING: gh is not available: not checking whether the PR of '$b' is merged / gh が無いので、'$b' の PR がマージ済みかは確認しません" >&2
    continue
  fi
  if ! prs=$(gh pr list --head "$b" --state all --json number,state --jq '.[] | "\(.state) \(.number)"' 2>/dev/null); then
    echo "pre-push: WARNING: could not ask GitHub about '$b': not checking / GitHub への問い合わせに失敗したので、'$b' は確認しません" >&2
    continue
  fi
  case $'\n'"$prs" in *$'\n'OPEN\ *) continue ;; esac
  n=$(printf '%s\n' "$prs" | awk '$1 == "MERGED" || $1 == "CLOSED" { print "#" $2; exit }')
  [ -n "$n" ] || continue
  cat >&2 <<MSG
pre-push: REFUSED. branch '$b' has a merged/closed PR $n: pushing commits here will not reach main.
  Create a new branch from origin/main and cherry-pick:
    git switch -c <new> origin/main; git cherry-pick <sha>
pre-push: 拒否しました。ブランチ '$b' の PR $n はマージ済み(または閉じています)。ここに push したコミットは main に入りません。
  origin/main から新しいブランチを作り、cherry-pick してください(上のコマンド)。
  意図した push なら RIVUS_ALLOW_PUSH_TO_MERGED=1 を付けます。
MSG
  status=1
done
exit $status
